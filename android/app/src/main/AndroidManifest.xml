<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.offline.docscanner">

    <!-- ======================================================== -->
    <!-- PERMISOS ESTRICTAMENTE NECESARIOS (100% OFFLINE)         -->
    <!-- NOTA: NO SE SOLICITA android.permission.INTERNET         -->
    <!-- Garantizando aislamiento total y cero telemetría externa -->
    <!-- ======================================================== -->
    
    <!-- Permiso de captura de cámara para escaneo de documentos -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Características de hardware de cámara (opcional para permitir instalación en tablets/dispositivos sin flash) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Compatibilidad con almacenamiento en Android 9 (API 28) o inferior -->
    <!-- En Android 10+ (API 29+) se utiliza Scoped Storage automático y MediaStore sin permisos peligrosos -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="Escáner Local"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- Tema normal después de la pantalla de inicio -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FileProvider para compartir archivos PDF e imágenes de forma local y segura -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
